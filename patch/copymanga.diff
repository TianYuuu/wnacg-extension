diff --git a/src/zh/copymanga/build.gradle.kts b/src/zh/copymanga/build.gradle.kts
index f71c2f6..0d44561 100644
--- a/src/zh/copymanga/build.gradle.kts
+++ b/src/zh/copymanga/build.gradle.kts
@@ -11,21 +11,56 @@ android {
             kotlin.directories.add("test")
         }
     }
+
+    // 关闭 R8 压缩混淆：Tachimanga（iOS）的字节码校验器会拒绝 R8 优化后的字节码
+    // （java.lang.VerifyError: JVMVRFY021 class=k ...）。代价只是 APK 变大。
+    buildTypes {
+        named("release") {
+            isMinifyEnabled = false
+            isShrinkResources = false
+        }
+    }
+}
+
+// Tachimanga（iOS）运行时自带的是旧版 kotlinx-serialization（GeneratedSerializer 只有
+// DefaultImpls，没有新式默认方法）。而 1.10+ 的 core 里该接口改成了 JVM 默认方法，编译后
+// D8 会生成对 GeneratedSerializer$-CC 的静态调用，旧运行时里没有这个类，于是抛
+// java.lang.NoClassDefFoundError: kotlinx/serialization/internal/GeneratedSerializer$_CC。
+// 这里把编译期使用的 serialization 固定到仍然是 DefaultImpls 形态的 1.7.3，
+// 生成的序列化代码就只会调用 GeneratedSerializer$DefaultImpls（新旧运行时都有）。
+configurations.configureEach {
+    resolutionStrategy {
+        force(
+            "org.jetbrains.kotlinx:kotlinx-serialization-core:1.7.3",
+            "org.jetbrains.kotlinx:kotlinx-serialization-core-jvm:1.7.3",
+            "org.jetbrains.kotlinx:kotlinx-serialization-json:1.7.3",
+            "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm:1.7.3",
+            "org.jetbrains.kotlinx:kotlinx-serialization-json-okio:1.7.3",
+            "org.jetbrains.kotlinx:kotlinx-serialization-json-okio-jvm:1.7.3",
+        )
+    }
 }
 
 tasks.matching { it.name.startsWith("ksp") && it.name.contains("UnitTest") }.configureEach {
     enabled = false
 }
 
+// 关掉 R8 之后，插件里「生成扩展 jar」那两步会去找 R8 的 configuration.txt（已不存在），
+// 我们发布的是 APK，这个 jar 用不上。
+tasks.matching { it.name == "createReleaseExtensionJar" || it.name == "signReleaseExtensionJar" }
+    .configureEach { enabled = false }
+
 keiyoushi {
     name = "CopyManga"
+    pkgName = "zh.copymanga"
     versionCode.set(
-        providers.gradleProperty("extensionReleaseVersionCode").map { it.toInt() }.orElse(8),
+        providers.gradleProperty("extensionReleaseVersionCode").map { it.toInt() }.orElse(111),
     )
     contentWarning = ContentWarning.MIXED
     libVersion = "1.6"
 
     source {
+        // 包名、源名、源 id 都与原版一致，装好后旧的收藏/进度直接沿用
         name = "拷贝漫画"
         lang = "zh"
         baseUrl = "https://www.mangacopy.com"
