diff --git a/build.gradle.kts b/build.gradle.kts
index 924c28c..1b62023 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -20,3 +20,14 @@ tasks {
         }
     }
 }
+
+// 兼容 Tachimanga（iOS）：Kotlin 2.x 默认用 invokedynamic 生成 lambda，D8 脱糖后
+// 留下的合成方法在 Tachimanga 的校验器下会抛 java.lang.VerifyError: JVMVRFY021。
+// 统一改成编译成普通类，字节码形态与 Kotlin 1.9 一致。
+subprojects {
+    tasks.withType<org.jetbrains.kotlin.gradle.tasks.KotlinCompile>().configureEach {
+        compilerOptions {
+            freeCompilerArgs.addAll("-Xlambdas=class", "-Xsam-conversions=class")
+        }
+    }
+}
